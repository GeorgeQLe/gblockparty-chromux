{
  "name": "chromux",
  "version": "0.76.4",
  "productName": "GBlockParty Chromux",
  "description": "OSS desktop front-end for local and GBlockParty-managed agent/browser workspaces.",
  "main": "main.js",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeorgeQLe/gblockparty-chromux.git",
    "directory": "prototype"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "chromux-resource-broker-mcp": "resource-broker/mcp-server.js",
    "chromux-resource-broker": "resource-broker/daemon.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:windows-platform": "node scripts/test-windows-platform.js",
    "test:ci:windows": "node scripts/test-windows-platform.js && node scripts/test-windows-setup.js && node scripts/test-windows-sign.js && node scripts/test-windows-artifacts.js && node scripts/test-user-data-path.js && node scripts/test-github-update-check.js && node scripts/test-codex-update-service.js && node scripts/test-codex-detect-metadata.js && node scripts/test-prevent-sleep.js && node scripts/test-resource-broker.js && node scripts/test-storage-cleanup.js && node scripts/test-window-config.js",
    "start": "electron .",
    "smoke": "electron . --smoke --dev-mode",
    "fixture:localhost-first-success": "node examples/localhost-first-success/server.js",
    "test:localhost-first-success": "node scripts/test-localhost-first-success-http.js && node scripts/test-localhost-first-success-electron.js",
    "uat:localhost-first-success": "node scripts/uat-localhost-first-success.js",
    "activity-lab": "electron activity-lab-main.js --activity-lab",
    "test:activity-lab": "node scripts/test-activity-lab-core.js && node scripts/test-activity-lab-runner.js && node scripts/test-activity-lab-smoke.js && node scripts/test-codex-app-server-lifecycle.js",
    "sidebar-lab": "electron sidebar-lab-main.js --sidebar-lab",
    "test:sidebar-lab": "node scripts/test-sidebar-lab-core.js && node scripts/test-sidebar-lab-renderer.js && node scripts/test-sidebar-lab-smoke.js",
    "uat:sidebar-lab": "node scripts/run-sidebar-lab-uat.js",
    "test:codex-app-server-lifecycle": "node scripts/test-codex-app-server-lifecycle.js",
    "probe:codex-same-turn": "node scripts/run-same-turn-probe.js",
    "capture:themes": "node scripts/capture-themes.js",
    "capture:composer-themes": "node scripts/capture-full-browser-composer-themes.js",
    "broker:install": "node scripts/install-resource-broker-platform.js",
    "test:resource-broker": "node scripts/test-resource-broker.js && node scripts/test-resource-broker-integration.js && node scripts/test-resource-mcp-contract.js",
    "test:simulator-policy": "node scripts/test-simulator-policy.js",
    "test:resource-ui-renderer": "node scripts/test-resource-ui-renderer.js",
    "test:browser-isolation-smoke": "node scripts/test-browser-isolation-smoke.js",
    "test:storage-cleanup": "node scripts/test-storage-cleanup.js",
    "test:user-data-path": "node scripts/test-user-data-path.js",
    "smoke:simulator-broker": "node scripts/smoke-simulator-broker.js",
    "test:codex-detect-metadata": "node scripts/test-codex-detect-metadata.js",
    "test:detect-filter-renderer": "node scripts/test-detect-filter-renderer.js",
    "test:attention-signals-renderer": "npm run test:turn-signals-renderer",
    "test:attention-diagnostics": "node scripts/test-attention-diagnostics.js && node scripts/test-attention-diagnostics-renderer.js",
    "test:dev-mode": "node scripts/test-dev-mode.js && node scripts/test-dev-mode-renderer.js",
    "test:osc-parser": "node scripts/test-osc-parser.js",
    "test:turn-signals-renderer": "node scripts/test-turn-signals-renderer.js",
    "test:tab-activity-indicators-renderer": "node scripts/test-tab-activity-indicators-renderer.js",
    "test:session-rail-renderer": "node scripts/test-session-rail-renderer.js",
    "test:git-worktree-service": "node scripts/test-git-worktree-service.js",
    "test:vercel-service": "node scripts/test-vercel-service.js",
    "test:vercel-shipping-service": "node scripts/test-vercel-shipping-service.js",
    "test:vercel-oauth-loopback": "node scripts/test-vercel-oauth-loopback.js",
    "test:vercel-renderer": "node scripts/test-vercel-renderer.js",
    "test:tab-titles-renderer": "node scripts/test-tab-titles-renderer.js",
    "test:session-tab-groups-renderer": "node scripts/test-session-tab-groups-renderer.js",
    "test:resume-retry-renderer": "node scripts/test-resume-retry-renderer.js",
    "test:capture-records-renderer": "node scripts/test-capture-records-renderer.js",
    "test:capture-control-renderer": "node scripts/test-capture-control-renderer.js",
    "test:capture-main-integration": "node scripts/test-capture-main-integration.js",
    "uat:capture-delivery-recovery": "node scripts/test-capture-delivery-recovery.js --write-report",
    "test:preview-queue-renderer": "node scripts/test-preview-queue-renderer.js",
    "test:browser-queue": "node scripts/test-browser-queue.js",
    "test:preview-probe": "node scripts/test-preview-probe.js",
    "test:favorites-renderer": "node scripts/test-favorites-renderer.js",
    "test:projects-renderer": "node scripts/test-projects-renderer.js",
    "test:project-scaffolder": "node scripts/test-project-scaffolder.js",
    "test:project-launcher-renderer": "node scripts/test-project-launcher-renderer.js",
    "test:prompt-history": "node scripts/test-prompt-history.js",
    "test:composer-renderer": "node scripts/test-composer-renderer.js",
    "test:shortcuts-renderer": "node scripts/test-shortcuts-renderer.js",
    "test:hotkey-debug-renderer": "node scripts/test-hotkey-debug-renderer.js",
    "test:browser-collapse-renderer": "node scripts/test-browser-collapse-renderer.js",
    "test:full-browser-composer-renderer": "node scripts/test-full-browser-composer-renderer.js",
    "test:browser-tabs-html-explorer": "node scripts/test-browser-tabs-html-explorer.js",
    "test:webview-shortcuts-smoke": "node scripts/test-webview-shortcuts-smoke.js",
    "test:hotkey-debug-smoke": "node scripts/test-hotkey-debug-smoke.js",
    "test:agent-command-quoting": "node scripts/test-agent-command-quoting.js",
    "test:restore-session-identity": "node scripts/test-restore-session-identity.js",
    "test:codex-notifier": "node scripts/test-codex-notifier.js",
    "test:codex-update-service": "node scripts/test-codex-update-service.js",
    "test:codex-update-gate-renderer": "node scripts/test-codex-update-gate-renderer.js",
    "test:github-update-check": "node scripts/test-github-update-check.js",
    "test:window-config": "node scripts/test-window-config.js",
    "test:prevent-sleep": "node scripts/test-prevent-sleep.js && node scripts/test-prevent-sleep-renderer.js",
    "test:update-queue-renderer": "node scripts/test-update-queue-renderer.js",
    "test:shell-adoption-renderer": "node scripts/test-shell-adoption-renderer.js",
    "test:grok-warning-renderer": "node scripts/test-grok-warning-renderer.js",
    "test:streak-attention-click-targets-renderer": "node scripts/test-streak-attention-click-targets-renderer.js",
    "test:themes-renderer": "node scripts/test-themes-renderer.js",
    "test:synchronized-output-renderer": "node scripts/test-synchronized-output-renderer.js",
    "test:terminal-scroll-bottom-renderer": "node scripts/test-terminal-scroll-bottom-renderer.js",
    "test:startup-loader-renderer": "node scripts/test-startup-loader-renderer.js",
    "package": "npm run package:mac",
    "package:mac": "electron-packager . Chromux --platform=darwin --arch=arm64 --icon=build/icon --app-bundle-id=dev.georgele.chromux --extend-info=build/Info.plist --overwrite --out=dist --ignore='^/dist' --ignore='^/out' --ignore='^/build/icon.iconset' --asar.unpack='**/node_modules/node-pty/**'",
    "verify:packaged-settings": "node scripts/verify-packaged-settings-persistence.js",
    "icon:windows": "node scripts/build-windows-icon.js",
    "make:win": "npm run icon:windows && electron-forge make --platform=win32 --arch=x64",
    "install-app": "npm run package && node scripts/record-install-source.js && rm -rf /Applications/Chromux.app && cp -R dist/Chromux-darwin-arm64/Chromux.app /Applications/Chromux.app",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/xterm": "^5.5.0",
    "electron-squirrel-startup": "^1.0.1",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron/packager": "^20.0.2",
    "@electron/rebuild": "^4.1.0",
    "@electron/windows-sign": "^2.0.6",
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^43.0.0",
    "png-to-ico": "^2.1.8"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
